VITE_API_URL=/api
VITE_RECOMMENDER_URL=/api/v1
VITE_ASSISTANT_URL=/api/assistant
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_VK_CLIENT_ID=your-vk-client-id-here
VITE_VK_AUTH_ENABLED=false

# Local Vite and production nginx both use same-origin routes. Vite proxies
# `/api` and `/media` to Django on port 8001 during local development.
