# Database Configuration
DB_NAME=excursions
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=prefer
DB_SSLROOTCERT=
DB_CONN_MAX_AGE=60
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/excursions
DATABASE_ECHO=False

# Redis Configuration
REDIS_PORT=6379
REDIS_PASSWORD=change-me-for-production
REDIS_URL=redis://redis:6379/0
ASSISTANT_REDIS_URL=redis://redis:6379/2

# RabbitMQ Configuration
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE=excursion_events

# Django Configuration
DJANGO_PORT=8001
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,main-service,recommender_api
ASSISTANT_ALLOWED_HOSTS=localhost,127.0.0.1,assistant-service
DOMAIN=localhost:8001
PROTOCOL=http
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Recommendation Service Configuration
RECOMMENDER_PORT=8002
DJANGO_BASE_URL=http://main-service:8000
RECOMMENDER_BASE_URL=http://recommender_api:8000

# Assistant Service Configuration
ASSISTANT_PORT=8000
CHROMA_PERSIST_DIR=/data/chroma
ASSISTANT_SECRET_KEY=your-assistant-secret-key-here
YANDEX_API_KEY=your-yandex-api-key
YANDEX_FOLDER_ID=your-yandex-folder-id

# Celery Configuration
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Model Configuration
MODEL_PATH=/app/models/
TOP_K=20
COLD_START_MIN_INTERACTIONS=3

# Hybrid Algorithm Weights
HYBRID_ALPHA=0.35
POPULARITY_WEIGHT=0.2

# iALS Configuration
IALS_FACTORS=128
IALS_REGULARIZATION=0.05
IALS_ITERATIONS=15
IALS_ALPHA=2.0

# pgVector Configuration
PGVECTOR_INDEX_LISTS=100

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
CORS_ORIGINS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://main-service:8000

# SMTP Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.timeweb.ru
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=
EMAIL_TIMEOUT=10

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
VK_CLIENT_ID=your-vk-client-id-here
VK_CLIENT_SECRET=your-vk-client-secret-here

# YooKassa Configuration
YOOKASSA_SHOP_ID=your-yookassa-shop-id
YOOKASSA_SECRET_KEY=your-yookassa-secret-key
YOOKASSA_RETURN_URL=http://localhost:5173/payment/return
YOOKASSA_WEBHOOK_SECRET=change-me
YOOKASSA_CAPTURE=true
YOOKASSA_VAT_CODE=1
YOOKASSA_CURRENCY=RUB
