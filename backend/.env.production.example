# Compose
ENV_FILE=.env.production
DOMAIN=koleso-travel55.ru
SERVER_NAMES=koleso-travel55.ru www.koleso-travel55.ru
LETSENCRYPT_DIR=/etc/letsencrypt

# Timeweb PostgreSQL DBaaS
DB_NAME=excursions
DB_USER=gen_user
DB_PASSWORD=change-me
DB_HOST=192.168.0.5
DB_PORT=5432
DB_SSLMODE=disable
DB_CONN_MAX_AGE=60
DATABASE_URL=postgresql+asyncpg://gen_user:change-me@192.168.0.5:5432/excursions
DATABASE_ECHO=False

# Django
SECRET_KEY=change-me-with-a-long-random-value
ASSISTANT_SECRET_KEY=change-me-with-another-long-random-value
DEBUG=False
ALLOWED_HOSTS=koleso-travel55.ru,www.koleso-travel55.ru,main-service
ASSISTANT_ALLOWED_HOSTS=koleso-travel55.ru,www.koleso-travel55.ru,assistant-service
PROTOCOL=https
CORS_ORIGINS=https://koleso-travel55.ru,https://www.koleso-travel55.ru
CSRF_TRUSTED_ORIGINS=https://koleso-travel55.ru,https://www.koleso-travel55.ru
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False

# Redis
REDIS_PASSWORD=change-me-with-a-random-password
REDIS_URL=redis://:change-me-with-a-random-password@redis:6379/0
ASSISTANT_REDIS_URL=redis://:change-me-with-a-random-password@redis:6379/2
CELERY_RESULT_BACKEND=redis://:change-me-with-a-random-password@redis:6379/1

# RabbitMQ
RABBITMQ_USER=koleso
RABBITMQ_PASS=change-me-with-a-random-password
RABBITMQ_URL=amqp://koleso:change-me-with-a-random-password@rabbitmq:5672/
RABBITMQ_QUEUE=excursion_events
RABBITMQ_EXCHANGE=excursion_events
CELERY_BROKER_URL=amqp://koleso:change-me-with-a-random-password@rabbitmq:5672//

# Internal services
DJANGO_BASE_URL=http://main-service:8000
RECOMMENDER_BASE_URL=http://recommender_api:8000
CHROMA_PERSIST_DIR=/data/chroma
ANONYMIZED_TELEMETRY=False

# Yandex assistant and embeddings
YANDEX_API_KEY=change-me
YANDEX_FOLDER_ID=change-me

# Timeweb SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.timeweb.ru
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=noreply@koleso-travel55.ru
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=noreply@koleso-travel55.ru
SERVER_EMAIL=noreply@koleso-travel55.ru
EMAIL_TIMEOUT=10

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Recommendation model
MODEL_PATH=/app/models/
TOP_K=20
COLD_START_MIN_INTERACTIONS=3
HYBRID_ALPHA=0.35
POPULARITY_WEIGHT=0.2
IALS_FACTORS=128
IALS_REGULARIZATION=0.05
IALS_ITERATIONS=15
IALS_ALPHA=2.0
PGVECTOR_INDEX_LISTS=100

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
