# Database Configuration
DATABASE_URL=postgresql+asyncpg://recommender_user:recommender_pass@recommender_postgres:5432/recommender

# RabbitMQ Configuration (uses existing service)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE=excursion_events

# Redis Configuration (new service for recommendation service)
REDIS_URL=redis://recommender_redis:6379/0

# Celery Configuration
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672/
CELERY_RESULT_BACKEND=redis://recommender_redis:6379/1

# Model Configuration
MODEL_PATH=/app/models/
TOP_K=20
HYBRID_ALPHA=0.35
POPULARITY_WEIGHT=0.2
COLD_START_MIN_INTERACTIONS=3

# IALS Collaborative Filtering Parameters
IALS_FACTORS=128
IALS_REGULARIZATION=0.05
IALS_ITERATIONS=15
IALS_ALPHA=2.0

# PostgreSQL pgvector Configuration
PGVECTOR_INDEX_LISTS=100

# Training Configuration
RETRAIN_THRESHOLD=100

# Django Integration (for admin sync)
DJANGO_BASE_URL=http://main_service:8000
DJANGO_API_TOKEN=your_django_api_token_here

# Service Configuration
SERVICE_NAME=recommendation-service
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000

# Logging
LOG_LEVEL=INFO
